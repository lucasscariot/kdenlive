set -euo pipefail

launcher=$(readlink -f -- "${BASH_SOURCE[0]}")
live_prefix=$(cd -- "$(dirname -- "$launcher")/.." && pwd)
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}/kdenlive-live"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/kdenlive-live"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}/kdenlive-live"
export XDG_DATA_DIRS="$live_prefix/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export KDENLIVE_MCP_BRIDGE=1
mkdir -p "$XDG_CONFIG_HOME" "$XDG_DATA_HOME" "$XDG_CACHE_HOME"

exec "$live_prefix/bin/kdenlive" --desktopfile org.kde.kdenlive.live \
  --config "$XDG_CONFIG_HOME/kdenliverc" "$@"
